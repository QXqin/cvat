#
# Base image for TransT tracker deployment in CVAT/Nuclio.
# Uses Tsinghua mirrors for faster downloads in China; remove the
# mirror lines if deploying from outside China.

FROM ubuntu:22.04

# NVIDIA runtime environment variables
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENV PYTHONPATH=/opt/nuclio/trans-t

# System dependencies
# NOTE: The APT mirror lines below use mirrors.tuna.tsinghua.edu.cn for
# faster access in China. Remove or replace them for other regions.
RUN sed -i 's/archive.ubuntu.com/mirrors.tuna.tsinghua.edu.cn/g' /etc/apt/sources.list \
  && sed -i 's/security.ubuntu.com/mirrors.tuna.tsinghua.edu.cn/g' /etc/apt/sources.list \
  && apt update \
  && apt install -y --no-install-recommends \
    python-is-python3 \
    python3 \
    python3-pip \
  && rm -rf /var/lib/apt/lists/*

# Python dependencies
# NOTE: The PyPI index below uses pypi.tuna.tsinghua.edu.cn for faster
# access in China. Remove the `pip config set` line for other regions.
RUN pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple \
  && pip install \
  jsonpickle opencv-python-headless \
  torch==1.13.1+cu117 torchvision==0.14.1+cu117 numpy==1.26.4 \
  --extra-index-url https://download.pytorch.org/whl/cu117 \
  --no-cache-dir

WORKDIR /opt/nuclio

# Copy TransT source and model weights (pre-downloaded locally)
COPY trans-t /opt/nuclio/trans-t
RUN find /opt/nuclio/trans-t -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null; true
COPY transt.pth /transt.pth

# Pre-load ResNet50 backbone into the PyTorch hub cache to prevent
# runtime downloads that cause 504 Gateway Timeout on first invocation.
RUN mkdir -p /root/.cache/torch/hub/checkpoints
COPY resnet50-0676ba61.pth /root/.cache/torch/hub/checkpoints/resnet50-0676ba61.pth
